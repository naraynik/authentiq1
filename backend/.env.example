# ==============================================================================
# AUTHENIQ UNIFIED BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application & API Settings
PROJECT_NAME="AuthentiQ Unified Backend"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG="True"

# Database Configuration (PostgreSQL). For a quick local try: sqlite:///./authentiq.db
DATABASE_URL="postgresql://user:password@localhost:5432/authentiq"

# Security & JWT Configuration
SECRET_KEY="your-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Seed Credentials
ADMIN_EMAIL="admin@authentiq.com"
ADMIN_PASSWORD="your-secure-admin-password"

# EVM Blockchain RPC Node & Smart Contract Settings
RPC_URL="http://127.0.0.1:8545"
CHAIN_ID=1337
# Leave empty: the backend deploys ProductVerification on first start and saves the
# address in CONTRACT_STATE_FILE. Set it only to use an already deployed contract.
CONTRACT_ADDRESS=""
CONTRACT_STATE_FILE="data/contract.json"
AUTO_DEPLOY_CONTRACT="True"
CONTRACT_ABI_PATH="app/contracts/ProductVerification.json"
BLOCKCHAIN_PRIVATE_KEY="your-ganache-or-evm-private-key-hex"

# AI Model File Configuration
RF_MODEL_PATH="app/models/rf_advanced_model.joblib"
GNN_MODEL_PATH="app/models/gnn_advanced_model.pt"

# File Storage Configuration
UPLOAD_DIR="app/uploads"
MAX_UPLOAD_SIZE=10485760

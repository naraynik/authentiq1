# AuthentiQ deployment settings (used by docker-compose.yml). Copy to .env and fill in.
# Never commit .env.

# Database password (any long random string)
POSTGRES_PASSWORD=

# Signs login tokens. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The admin portal login (created on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Key of the account that writes to the private blockchain (0x + 64 hex characters).
# It is funded automatically on this private chain. Generate one:
#   python -c "import secrets; print('0x' + secrets.token_hex(32))"
BLOCKCHAIN_PRIVATE_KEY=

# Optional
WEB_PORT=80                 # port for the website when not using HTTPS
DOMAIN=                     # e.g. authentiq.example.com, for docker-compose.https.yml
CORS_ORIGINS=               # only if the website is served from a different domain than the API
CONTRACT_ADDRESS=           # leave empty: the contract is deployed automatically and remembered
